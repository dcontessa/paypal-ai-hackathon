# PayPal sandbox app credentials (Developer Dashboard > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# Anthropic API key for the agent layer. Leave blank to use the built-in template agent.
ANTHROPIC_API_KEY=

# Public base URL of this deployment, used to register the PayPal webhook (e.g. https://recoup.onrender.com)
PUBLIC_URL=

# Timezone used for the mandate's quiet hours
MERCHANT_TIMEZONE=Asia/Kuala_Lumpur

# Set to "true" to start with seeded demo cases
DEMO_MODE=true

PORT=3000
